# =================================================================
# UNIQUE PATHOLOGY (MANDIDEEP, BHOPAL, MP) - BACKEND CONFIGURATION
# =================================================================

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB Connection String (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/unique_pathology

# JWT Authentication
JWT_SECRET=unique_pathology_mandideep_super_secure_jwt_secret_key_change_me_in_prod
JWT_EXPIRES_IN=2h

# Admin Credentials
ADMIN_EMAIL=admin@uniquepathology.example
# To generate a new bcrypt password hash:
# node -e "require('bcryptjs').hash('YOUR_PASSWORD', 12).then(console.log)"
# Default dev hash below is for: UniqueAdmin@2026
ADMIN_PASSWORD_HASH=$2a$12$JWB7gcCmsPmct0aL0KIf6u42cKroKx/7A.xyQgKYJWBz36oa8dXEm

# Razorpay Test / Live Credentials (leave blank to run in offline / desk payment mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Private Storage for Patient Diagnostic Reports (Never serve statically!)
REPORTS_STORAGE_PATH=./storage/reports
REPORTS_LINK_EXPIRES_MINUTES=15

# Real SMS Gateway Configuration for Patient OTP Delivery
# Use Fast2SMS (popular Indian gateway, https://www.fast2sms.com) or Twilio
SMS_PROVIDER=auto
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# Business Details (Leave blank or fill once lab officially confirms)
# WhatsApp button and phone calls activate only when valid phone numbers are configured below
BUSINESS_PHONE=
WHATSAPP_NUMBER=
BUSINESS_EMAIL=contact@uniquepathology.example
BUSINESS_ADDRESS=[Mandideep Centre, Bhopal Region, Madhya Pradesh — Exact Building Address Pending Verification]
